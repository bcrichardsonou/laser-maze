[Unit]
Description=Laser Maze physical-panel game controller
After=local-fs.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=brent
Group=brent
WorkingDirectory=/home/brent/laser-maze/deployments/current
ExecStart=/usr/bin/python3 -u /home/brent/laser-maze/deployments/current/panel_game.py /dev/serial/by-id/usb-Arduino_UNO_R4_Minima_EXAMPLE_UNO_SERIAL-if00
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=8
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
